---
interface Props {
  class?: string
}

const { class: className = 'h-4 w-4 shrink-0' } = Astro.props
---

<svg
  viewBox="0 0 24 24"
  fill="none"
  aria-hidden="true"
  focusable="false"
  class={className}
>
  <rect width="24" height="24" rx="5" fill="#131010" />
  <rect x="6" y="4.5" width="12" height="15" fill="#fff" />
  <rect x="8.93" y="7.87" width="6" height="2.53" fill="#131010" />
  <rect x="8.93" y="10.4" width="6" height="6.13" fill="#5a5858" />
</svg>
