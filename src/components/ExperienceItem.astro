---
import type { Experience } from '../data/experience'

interface Props {
  item: Experience
}

const { item } = Astro.props
---

<li class="relative border-l-2 border-neutral-200 pb-8 pl-6 last:pb-0">
  <span
    aria-hidden="true"
    class="absolute -left-[7px] top-1 h-3 w-3 rounded-full bg-neutral-900"
  ></span>
  <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
    <h3 class="text-base font-semibold">
      {item.role} · {item.company}
    </h3>
    <p class="shrink-0 text-xs text-neutral-500">{item.period}</p>
  </div>
  <p class="mt-1 flex flex-wrap items-center gap-2 text-xs text-neutral-500">
    <span>{item.location}</span>
    <span class="inline-flex items-center rounded-full border border-neutral-300 px-2 py-0.5 text-[11px] font-medium text-neutral-700">
      {item.workMode}
    </span>
  </p>
  <ul class="mt-3 list-disc space-y-1.5 pl-5 text-sm leading-relaxed text-neutral-700">
    {item.highlights.map((point) => (
      <li>{point}</li>
    ))}
  </ul>
</li>
