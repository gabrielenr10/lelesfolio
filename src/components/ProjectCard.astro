---
import { Image } from 'astro:assets'
import type { Project } from '../data/projects'

interface Props {
  project: Project
}

const { project } = Astro.props
---

<article
  aria-labelledby={`project-${project.id}-title`}
  class="rounded-3xl border border-neutral-200 bg-white p-5 shadow-[0_12px_40px_-12px_rgb(0_0_0_/_0.14)] sm:p-8"
>
  <div class="flex items-center justify-between gap-4">
    <h3
      id={`project-${project.id}-title`}
      class="text-xl font-semibold tracking-tight sm:text-2xl"
    >
      {project.title}
    </h3>
    <a
      href={`/projects/${project.id}`}
      aria-label={`View details for ${project.title}`}
      title="View project details"
      class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-violet-300 text-violet-700 transition-colors hover:border-violet-700 hover:bg-violet-50"
    >
      <svg
        aria-hidden="true"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M5 12h14M12 5l7 7-7 7" />
      </svg>
    </a>
  </div>
  {project.date && (
    <p class="mt-2 text-sm font-medium text-neutral-500">{project.date}</p>
  )}
  <p class="mt-3 max-w-prose text-sm leading-relaxed text-neutral-600 sm:text-base">
    {project.description}
  </p>
  <div class="mt-6 grid gap-4 sm:mt-8 sm:grid-cols-2">
    {project.images.map((image) => (
      <Image
        src={image.src}
        alt={image.alt}
        width="400"
        height="220"
        widths={[400, 800]}
        sizes="(min-width: 640px) 400px, calc(100vw - 74px)"
        format="webp"
        loading="lazy"
        decoding="async"
        class="rounded-2xl border border-neutral-200 bg-neutral-100"
      />
    ))}
  </div>
</article>
