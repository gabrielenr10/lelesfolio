---
interface Props {
  eyebrow: string
  title: string
  description?: string
}

const { eyebrow, title, description } = Astro.props
---

<div class="mb-6 text-center sm:mb-8 md:text-left">
  <p class="text-xs font-semibold uppercase tracking-widest text-neutral-500">
    {eyebrow}
  </p>
  <h2 class="mt-2 text-2xl font-bold tracking-tight sm:text-3xl">{title}</h2>
  {description && (
    <p class="mx-auto mt-2 max-w-prose text-sm text-neutral-600 md:mx-0 sm:text-base">
      {description}
    </p>
  )}
</div>
