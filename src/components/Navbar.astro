---
import { navigation } from '../data/navigation'
---

<header
  id="site-header"
  class="fixed inset-x-0 bottom-0 z-50 px-4 pb-[max(1rem,env(safe-area-inset-bottom))] md:sticky md:top-0 md:px-0 md:pb-0"
>
  <nav
    id="site-nav"
    aria-label="Primary"
    class="mx-auto flex max-w-4xl items-center justify-center border border-neutral-200 bg-white/90 backdrop-blur motion-safe:transition-[border-radius,padding] motion-safe:duration-300"
  >
    <ul class="flex w-full flex-1 items-center justify-center gap-1 md:gap-2">
      {navigation.map((link) => (
        <li class="flex-1 text-center md:w-28 md:flex-none">
          <a
            href={link.href}
            class="block w-full rounded-full px-2 py-2.5 text-center text-xs font-medium text-neutral-600 transition-colors hover:bg-neutral-100 hover:text-neutral-950 focus-visible:outline-2 focus-visible:outline-offset-2 aria-[current=true]:bg-neutral-100 aria-[current=true]:font-semibold aria-[current=true]:text-neutral-950 md:py-1.5 md:text-sm md:hover:bg-transparent md:hover:aria-[current=true]:bg-neutral-100"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<script>
  const header = document.getElementById('site-header')
  const onScroll = () => {
    header?.classList.toggle('is-scrolled', window.scrollY > 16)
  }
  onScroll()
  window.addEventListener('scroll', onScroll, { passive: true })

  // Scrollspy: mark the link of the section currently in view. The observer
  // band (-40% top / -55% bottom) means exactly one section is active at a
  // time. When nothing intersects (e.g. footer in view) the last active link
  // is kept, so the menu never flickers to "nothing selected" at page bottom.
  const navAnchors = [...document.querySelectorAll('#site-nav a[href^="#"]')]
  const sectionById = new Map()
  for (const anchor of navAnchors) {
    const id = anchor.getAttribute('href')
    if (id && id.length > 1) {
      const section = document.querySelector(id)
      if (section) sectionById.set(id, { anchor, section })
    }
  }

  let currentId = null
  const setActive = (id) => {
    if (currentId === id) return
    currentId = id
    for (const [key, { anchor }] of sectionById) {
      if (key === id) anchor.setAttribute('aria-current', 'true')
      else anchor.removeAttribute('aria-current')
    }
  }

  if ('IntersectionObserver' in window && sectionById.size > 0) {
    const visible = new Set()
    const order = [...sectionById.keys()]
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const id = `#${entry.target.id}`
          if (entry.isIntersecting) visible.add(id)
          else visible.delete(id)
        }
        if (visible.size > 0) {
          const ordered = order.filter((id) => visible.has(id))
          setActive(ordered[ordered.length - 1])
        }
      },
      { rootMargin: '-40% 0px -55% 0px' },
    )
    for (const { section } of sectionById.values()) observer.observe(section)
  }
</script>

<style>
  /* State-only styles: static look (border color, background, layout) lives
     in Tailwind utilities above. This block only handles the scrolled-state
     morphing across breakpoints, which is clearer here than as a long chain
     of ancestor-state utility variants.
     Note: only border-radius/padding are transitioned (see nav classes).
     border-width and box-shadow switch instantly with the state, otherwise
     the border would visibly fade out on the flat bar when scrolling back
     to the top. */

  /* Small screens: docked bottom floating pill */
  #site-nav {
    border-radius: 999px;
    box-shadow: 0 8px 30px rgb(0 0 0 / 0.12);
    padding: 0.375rem;
  }
  #site-header.is-scrolled #site-nav {
    box-shadow: 0 12px 40px rgb(0 0 0 / 0.16);
  }

  /* Large screens: borderless flat bar at top, floating pill once scrolled */
  @media (min-width: 768px) {
    #site-header {
      top: 0;
    }
    #site-header.is-scrolled {
      top: 0.75rem;
    }
    #site-nav {
      border-width: 0;
      border-radius: 0;
      box-shadow: none;
      padding: 1.25rem 1rem 1.25rem;
    }
    #site-header.is-scrolled #site-nav {
      max-width: fit-content;
      border-width: 1px;
      border-radius: 999px;
      box-shadow: 0 8px 30px rgb(0 0 0 / 0.12);
      padding: 0.375rem 0.5rem;
    }
  }
</style>
