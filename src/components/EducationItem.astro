---
import type { Education } from '../data/education'

interface Props {
  item: Education
}

const { item } = Astro.props
---

<li class="relative border-l-2 border-neutral-200 pb-8 pl-6 last:pb-0">
  <span
    aria-hidden="true"
    class="absolute -left-[7px] top-1 h-3 w-3 rounded-full bg-neutral-400"
  ></span>
  <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
    <h3 class="text-base font-semibold">
      {item.degree} · {item.school}
    </h3>
    <p class="shrink-0 text-xs text-neutral-500">{item.period}</p>
  </div>
  {item.notes && (
    <p class="mt-2 text-sm leading-relaxed text-neutral-700">{item.notes}</p>
  )}
</li>
