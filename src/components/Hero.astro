---
import { Image } from 'astro:assets'
import type { Profile } from '../data/profile'
import { socials, type Social } from '../data/socials'
import avatar from '../assets/Angeles.jpeg'
import GitHubIcon from './icons/GitHubIcon.astro'
import GmailIcon from './icons/GmailIcon.astro'
import LinkedInIcon from './icons/LinkedInIcon.astro'

interface Props {
  profile: Profile
}

const { profile } = Astro.props

const icons = {
  GitHub: GitHubIcon,
  LinkedIn: LinkedInIcon,
  Email: GmailIcon,
} as const

type HeroSocialLabel = keyof typeof icons

const heroSocials = socials.filter(
  (social): social is Social & { label: HeroSocialLabel } =>
    (Object.keys(icons) as string[]).includes(social.label),
)
---

<section id="home" aria-labelledby="hero-title" class="scroll-mt-24">
  <div class="mx-auto grid max-w-4xl gap-8 px-4 py-12 text-center sm:py-16 md:grid-cols-[3fr_1fr] md:items-center md:text-left">
    <div class="order-2 md:order-1">
      <p class="text-base font-medium text-neutral-500 sm:text-lg">
        Hi, I&apos;m {profile.name}
      </p>
      <h1
        id="hero-title"
        class="mt-2 text-4xl font-bold tracking-tight sm:text-5xl md:text-6xl"
      >
        {profile.role}
      </h1>
      <p class="mt-3 text-lg font-medium text-neutral-800 sm:text-xl">
        {profile.tagline}
      </p>
      <p class="mx-auto mt-3 max-w-prose text-base leading-relaxed text-neutral-600 md:mx-0 sm:text-lg">
        {profile.summary}
      </p>
      <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:justify-center md:justify-start">
        <a
          href="#experience"
          class="rounded-full bg-neutral-100 px-6 py-2.5 text-sm font-medium text-neutral-950 transition-colors hover:bg-neutral-200"
        >
          View experience
        </a>
        <a
          href="#skills"
          class="rounded-full border border-neutral-300 px-6 py-2.5 text-sm font-medium text-neutral-900 transition-colors hover:border-neutral-900"
        >
          View skills
        </a>
      </div>
      <ul
        aria-label="Social links"
        class="mt-6 flex items-center justify-center gap-3 md:justify-start"
      >
        {heroSocials.map((social) => {
          const Icon = icons[social.label]
          const isExternal = social.href.startsWith('http')

          return (
            <li>
              <a
                href={social.href}
                target={isExternal ? '_blank' : undefined}
                rel={isExternal ? 'me noopener' : undefined}
                aria-label={social.label}
                class="flex h-10 w-10 items-center justify-center rounded-xl border border-neutral-300 text-neutral-700 transition-colors hover:bg-neutral-100"
              >
                <Icon class="h-5 w-5" />
              </a>
            </li>
          )
        })}
      </ul>
    </div>
    <div class="order-1 mx-auto md:order-2 md:justify-self-center">
      <Image
        src={avatar}
        alt={profile.imageAlt}
        width={320}
        height={320}
        format="webp"
        loading="eager"
        decoding="async"
        class="h-28 w-28 rounded-full border-4 border-white bg-neutral-100 object-cover shadow-md ring-2 ring-neutral-200 sm:h-32 sm:w-32 md:h-40 md:w-40"
      />
    </div>
  </div>
</section>
