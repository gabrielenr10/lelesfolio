---
import '../styles/global.css'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="shortcut icon" sizes="16x16 32x32 48x48" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta
      name="description"
      content="Sorry, the page you are looking for doesn't exist. Head back to the homepage."
    />
    <title>Page not found — Ángeles Bocharán's Portfolio</title>
  </head>
  <body class="min-h-screen bg-white text-neutral-900 antialiased">
    <main class="relative flex min-h-screen items-center justify-center overflow-hidden">
      <div
        aria-hidden="true"
        class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_1px_1px,rgb(0_0_0/0.08)_1px,transparent_0)] [background-size:22px_22px] [mask-image:radial-gradient(ellipse_60%_55%_at_50%_40%,black,transparent)]"
      ></div>

      <section
        aria-labelledby="not-found-title"
        class="relative mx-auto flex w-full max-w-xl flex-col items-center px-4 py-14 text-center sm:py-20"
      >
        <svg
          role="img"
          aria-label="The number 404 fading out"
          viewBox="0 0 320 180"
          width="180"
          height="101"
          style="width: 480px; max-width: 55vw; height: auto;"
          class="mt-2 shrink-0"
        >
          <defs>
            <linearGradient id="fade-404" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#171717"></stop>
              <stop offset="62%" stop-color="#525252"></stop>
              <stop
                offset="100%"
                stop-color="#d4d4d4"
                stop-opacity="0.3"
              ></stop>
            </linearGradient>
          </defs>

          <ellipse cx="160" cy="158" rx="90" ry="10" fill="#f5f5f5"></ellipse>
          <text
            x="160"
            y="132"
            text-anchor="middle"
            font-family="ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif"
            font-size="110"
            font-weight="800"
            letter-spacing="-4"
            fill="url(#fade-404)"
          >
            404
          </text>
        </svg>

        <h1
          id="not-found-title"
          class="mt-6 text-4xl font-bold tracking-tight sm:text-5xl"
        >
          This page went missing
        </h1>
        <p class="mx-auto mt-4 max-w-prose text-base leading-relaxed text-neutral-600 sm:text-lg">
          Sorry, we can&apos;t find the page you&apos;re looking for. It might
          have been moved, deleted, or the link may be broken.
        </p>
        <a
          href="/"
          class="rounded-full bg-neutral-100 px-6 py-2.5 mt-4 text-sm font-medium text-neutral-950 transition-colors hover:bg-neutral-200"
        >
          Go back home
        </a>
      </section>
    </main>
  </body>
</html>
